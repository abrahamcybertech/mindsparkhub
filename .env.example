# Copy to .env and fill in production values.
# Local development uses mindspark.db when DATABASE_URL is empty.

# Supabase Postgres transaction pooler connection string (port 6543).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=3
# Run schema creation on connection. Leave false in production and use npm run db:migrate.
DB_AUTO_SCHEMA=false

NEXT_PUBLIC_SITE_URL=https://mindspark-hub.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Password reset emails are sent by Supabase Auth. Set the Auth SITE_URL and
# add {NEXT_PUBLIC_SITE_URL}/admin/reset-password to the redirect allow list.

# Optional Supabase Edge Function that accepts { to, subject, html, text }.
SUPABASE_EMAIL_FUNCTION=send-email

# Optional SMTP settings for future email features.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MindSpark Hub <no-reply@mindsparkhub.org>

SESSION_SECRET=replace-with-a-long-random-string
MFA_ENCRYPTION_KEY=replace-with-a-long-random-string

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional local SQLite seed password. If unset, db:seed generates one and prints it.
SEED_ADMIN_PASSWORD=
