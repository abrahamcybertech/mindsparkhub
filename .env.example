# Public configuration only. Never place secrets in EXPO_PUBLIC_ variables.
# Production API for the existing MindSpark Hub Next.js backend.
EXPO_PUBLIC_API_URL=https://mindspark-hub.vercel.app
EXPO_PUBLIC_SITE_URL=https://mindspark-hub.vercel.app

