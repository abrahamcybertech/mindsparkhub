{
  "name": "mindspark-hub-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-router"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx --yes expo-doctor",
    "test:copy-rules": "node scripts/check-writing-rules.mjs",
    "test:assets": "node scripts/check-assets.mjs",
    "test:security": "node scripts/test-mobile-security.mjs",
    "sync:check": "node scripts/auto-sync-and-check.mjs",
    "watch:sync": "node scripts/auto-sync-and-check.mjs --watch",
    "test": "npm run test:copy-rules && npm run test:assets && npm run test:security && npm run typecheck",
    "build:check": "npm run test && npm run lint && npm run doctor"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.105.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
