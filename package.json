{
  "name": "mindspark-hub-official",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:copy-rules && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/seed.mjs",
    "test:copy-rules": "node scripts/check-writing-rules.mjs",
    "test:security": "node scripts/test-security.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate-to-postgres.mjs",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "db:seed:postgres": "npm run db:migrate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.474.0",
    "next": "^14.2.24",
    "nodemailer": "^6.10.1",
    "otpauth": "^9.3.6",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.17",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
